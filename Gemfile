source "https://rubygems.org"

# The site is built by our GitHub Actions workflow and uploaded as a Pages
# artifact, so it can use the maintained Jekyll release instead of the legacy
# github-pages meta-gem dependency set.
gem "jekyll", "~> 4.4.1"
group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.17"
  gem "jekyll-sitemap", "~> 1.4"
end

# These standard libraries are gems on current Ruby releases.
gem "csv"
gem "bigdecimal"
